# Regras de cache e segurança (usadas quando o site é publicado no Netlify)
/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=()

# A página inicial e a configuração sempre são conferidas (para receber atualizações na hora)
/index.html
  Cache-Control: no-cache
/
  Cache-Control: no-cache
/config.js
  Cache-Control: no-cache

# Arquivos com número de versão (?v=...) podem ficar guardados no navegador por 1 ano
/js/*
  Cache-Control: public, max-age=31536000, immutable
/css/*
  Cache-Control: public, max-age=31536000, immutable
